DATABASE_URL=sqlite:///./app.db

# 带 Cookie 的 CORS 允许来源。
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://152.136.39.252:5173
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
ADMIN_REGISTRATION_ENABLED=true

# Session-scoped reference uploads.
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_FILES_PER_SESSION=10
UPLOAD_MAX_TOTAL_CHARS=50000

# Local curriculum-standard BM25 RAG. Vector retrieval is reserved for a later phase.
CURRICULUM_DIR=./data/curriculum
CURRICULUM_RAG_ENABLED=true
CURRICULUM_TOP_K=4
CURRICULUM_CANDIDATE_K=16
CURRICULUM_CHUNK_SIZE=512
CURRICULUM_CHUNK_OVERLAP=64
CURRICULUM_RERANK_ENABLED=true
CURRICULUM_VECTOR_ENABLED=true
CURRICULUM_VECTOR_REQUIRED=false
CURRICULUM_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CURRICULUM_EMBEDDING_MODEL_DIR=./data/models/bge-small-zh-v1.5
CURRICULUM_EMBEDDING_DEVICE=cpu
CURRICULUM_VECTOR_DIR=./data/curriculum_vector
CURRICULUM_VECTOR_COLLECTION=curriculum_chunks
CURRICULUM_SNAPSHOT_DIR=./data/curriculum_snapshots
CURRICULUM_SNAPSHOT_KEEP=3
CURRICULUM_HYBRID_VECTOR_WEIGHT=0.65
CURRICULUM_HYBRID_BM25_WEIGHT=0.35
CURRICULUM_EMBEDDING_BATCH_SIZE=8

# Main tutor through an OpenAI-compatible provider. Leave the key empty to use the local mock tutor.
LLM_API_KEY=
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_REASONING_ENABLED=false
LLM_HTTP_REFERER=http://127.0.0.1:5173
LLM_APP_TITLE=Inquiry Teaching Workbench

# Optional Dify Dataset retrieval for the main tutor. Leave empty to use mock teaching references.
DIFY_DATASET_API_URL=https://api.dify.ai/v1
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=

# Seven stage-specific Dify agents. Use "mock" for local development and "live" for real Dify calls.
DIFY_STAGE_AGENT_MODE=mock

# Optional stage agent configs. If empty, the service exposes seven mock stage agents.
# Example:
# DIFY_STAGE_AGENTS_JSON=[{"id":"stage_observation_start","stage_id":"observation_start","name":"情境探寻专家","description":"设计观察起点","api_url":"http://host/v1/chat-messages","api_key":"app-xxx","flow_names":["inquiry_7_stage"]}]
DIFY_STAGE_AGENTS_JSON=
